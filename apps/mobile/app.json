{
  "expo": {
    "name": "Listenimento",
    "slug": "listenimento",
    "scheme": "listenimento",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.listenimento.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.listenimento.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#170d08"
  }
}
