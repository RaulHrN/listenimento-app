# Copie para supabase/functions/.env (local) e configure em produção com:
#   supabase secrets set --env-file supabase/functions/.env

# TMDB → https://www.themoviedb.org/settings/api ("API Read Access Token")
TMDB_READ_TOKEN=

# RAWG → https://rawg.io/apidocs
RAWG_API_KEY=

# OpenTripMap → https://opentripmap.io/product
OPENTRIPMAP_API_KEY=

# Google Books (opcional, aumenta a cota) → https://console.cloud.google.com
GOOGLE_BOOKS_API_KEY=

# BoardGameGeek (jogos de tabuleiro) → registre o app em https://boardgamegeek.com/applications
# e gere um token. Uso estritamente não comercial.
BGG_API_TOKEN=

# Jikan (animes) não precisa de chave.
